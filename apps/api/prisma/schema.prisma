generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Document {
  id                 String         @id @default(cuid())
  documentNumber     String         @unique
  title              String
  type               String
  owner              String
  department         String
  confidentiality    String         @default("Internal")
  status             String         @default("Draft")
  version            Int            @default(1)
  lifecycle           String         @default("Draft")
  trainingStatus      String         @default("NotRequired")
  signatureStatus     String         @default("NotRequired")
  sharePointDriveId  String?
  sharePointItemId   String?
  sharePointPath      String?
  searchableContent   String?
  retentionYears     Int            @default(10)
  reviewDueAt        DateTime?
  effectiveAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  auditEvents        AuditEvent[]
  signatures         Signature[]
  workflowTasks      WorkflowTask[]
  renditions         DocumentRendition[]
}

model AuditEvent {
  id          String      @id @default(cuid())
  documentId  String
  action      String
  actor       String
  details     String?
  createdAt   DateTime    @default(now())
  document    Document    @relation(fields: [documentId], references: [id])
}

model Signature {
  id             String   @id @default(cuid())
  documentId     String
  signer         String
  provider       String
  signatureRef   String?
  signedVersion  Int
  signedAt       DateTime @default(now())
  document       Document @relation(fields: [documentId], references: [id])
}

model WorkflowTask {
  id          String   @id @default(cuid())
  documentId  String
  taskType    String
  assignee    String
  status      String   @default("Open")
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  document    Document @relation(fields: [documentId], references: [id])
}

model DocumentRendition {
  id               String   @id @default(cuid())
  documentId       String
  kind             String
  sharePointItemId String?
  createdAt        DateTime @default(now())
  document         Document @relation(fields: [documentId], references: [id])
}
